use valk.core
use valk.fs
use protobuf

test "Codegen emits expected Valk classes, enums, docs, and options" {
    let schema = "
syntax = \"proto3\";
package shop.v1;

// Order status
enum Status {
    STATUS_UNKNOWN = 0;
    STATUS_PAID = 1;
}

// Customer order
message Order {
    int64 id = 1;
    Status status = 2;
    optional string coupon = 3;
    repeated int32 item_ids = 4;
    map<string, int32> metadata = 5;
}
"
    let file = protobuf.parse_proto(schema) ! { assert(false) return }
    let code = protobuf.generate_valk(file)

    assert(code.contains("// Code generated by valk-protobuf. DO NOT EDIT."))
    assert(code.contains("use protobuf"))
    assert(code.contains("/// Order status"))
    assert(code.contains("+ enum Status: i32 {"))
    assert(code.contains("+ fn Status_from_proto(v: i32) Status"))
    assert(code.contains("/// Customer order"))
    assert(code.contains("+ class Order is protobuf.ProtoMessage {"))
    assert(code.contains("+ coupon: ?String (null)"))
    assert(code.contains("+ item_ids: Array[i32] (.{})"))
    assert(code.contains("+ metadata: Map[i32] (.{})"))
    assert(code.contains("+ fn encode_proto(w: protobuf.Writer)"))
    assert(code.contains("+ fn to_proto_bytes() String"))
    assert(code.contains("+ static fn decode_proto(data: local &[u8]) SELF !protobuf.Error"))
}

test "End-to-end codegen compiles with --lint --deny-warnings and runs cleanly" {
    let schema = "
syntax = \"proto3\";
package e2e.v1;

enum Role {
    option allow_alias = true;
    ROLE_UNSPECIFIED = 0;
    ROLE_MEMBER = 1;
    ROLE_USER = 1;
    ROLE_ADMIN = 2;
    ROLE_NEGATIVE = -5;
}

message Empty {}

// User profile message
message User {
    message Address {
        string city = 1;
        uint32 zip = 2;
        enum Type {
            TYPE_UNKNOWN = 0;
            TYPE_HOME = 1;
            TYPE_OFFICE = 2;
        }
        Type kind = 3;
    }

    int64 id = 1;
    string name = 2;
    sint32 balance = 3;
    float rating = 4;
    double score = 5;
    bool active = 6;
    Role role = 7;
    optional int32 age = 8;
    repeated int32 flags = 9;
    repeated Role roles = 10;
    repeated string nicknames = 11;
    repeated Address addresses = 12;
    Address primary = 13;
    map<string, int32> stats = 14;
    map<int64, Address> directory = 15;
    oneof auth {
        string password_hash = 16;
        bytes api_key = 17;
    }
    // Contextual Valk keyword as field name
    string default = 18;
}
"

    let file = protobuf.parse_proto(schema) ! {
        println("Parse error: %{E.message}")
        assert(false)
        return
    }
    let generated = protobuf.generate_valk(file)

    let tmp_dir = "tests/tmp/e2e_codegen"
    fs.create_dir_all(tmp_dir) ! { assert(false) return }

    let valk_json = "{\n    \"src\": \".\",\n    \"dependencies\": {\n        \"protobuf\": {\n            \"src\": \"../../..\"\n        }\n    }\n}\n"
    fs.write("%{tmp_dir}/valk.json", valk_json) ! { assert(false) return }
    fs.write("%{tmp_dir}/generated.valk", generated) ! { assert(false) return }

    let driver = "use protobuf

fn main() {
    // 1. Default-value omission for singular non-optional fields
    let empty_user = User {}
    assert(empty_user.to_proto_bytes().bytes == 0)

    // 2. Optional field set to 0 is still encoded and decoded as present
    let opt_zero = User { age: 0 }
    let opt_bytes = opt_zero.to_proto_bytes()
    assert(opt_bytes.bytes > 0)
    let opt_dec = User.decode_proto(opt_bytes) ! panic(E.message)
    let got_age = opt_dec.age ?! panic(\"age should be present\")
    assert(got_age == 0)

    // 3. Full round-trip with every feature
    let home = User_Address { city: \"Amsterdam\", zip: 1012, kind: User_Address_Type.TYPE_HOME }
    let work = User_Address { city: \"Utrecht\", zip: 3511, kind: User_Address_Type.TYPE_OFFICE }
    let u = User {
        id: 1234567890123
        name: \"Alice\"
        balance: -9950
        rating: 4.5
        score: 99.75
        active: true
        role: Role.ROLE_NEGATIVE
        age: 31
        flags: Array[i32]{ 1, -2, 300 }
        roles: Array[Role]{ Role.ROLE_MEMBER, Role.ROLE_ADMIN }
        nicknames: Array[String]{ \"ali\", \"ace\" }
        addresses: Array[User_Address]{ home, work }
        primary: home
        api_key: \"secret-bytes\"
        default_: \"escaped-keyword\"
    }
    u.stats.set(\"logins\", 42)
    u.stats.set(\"alerts\", 0)
    u.directory.set(100, work)

    let wire = u.to_proto_bytes()

    // Append unknown fields + unpacked repeated flag to test forward compat & unpacked decoding
    let extra = protobuf.Writer.new(wire.bytes + 32)
    extra.buffer.write(wire)
    extra.write_string(900, \"future-unknown\")
    extra.write_int32(9, 777) // unpacked repeated element appended to packed field 9
    let full_wire = extra.into_bytes()

    let dec = User.decode_proto(full_wire) ! panic(E.message)
    assert(dec.id == 1234567890123)
    assert(dec.name == \"Alice\")
    assert(dec.balance == -9950)
    assert(dec.rating == 4.5)
    assert(dec.score == 99.75)
    assert(dec.active == true)
    assert(dec.role == Role.ROLE_NEGATIVE)
    assert((dec.age ?? -1) == 31)
    assert(dec.flags.length == 4)
    assert((dec.flags.get(0) !? 0) == 1)
    assert((dec.flags.get(1) !? 0) == -2)
    assert((dec.flags.get(2) !? 0) == 300)
    assert((dec.flags.get(3) !? 0) == 777)
    assert(dec.roles.length == 2)
    assert((dec.roles.get(0) !? Role.ROLE_UNSPECIFIED) == Role.ROLE_MEMBER)
    assert((dec.roles.get(1) !? Role.ROLE_UNSPECIFIED) == Role.ROLE_ADMIN)
    assert(dec.nicknames.length == 2 && (dec.nicknames.get(1) !? \"\") == \"ace\")
    assert(dec.addresses.length == 2)
    let a0 = dec.addresses.get(0) ! panic(\"addr0\")
    assert(a0.city == \"Amsterdam\" && a0.zip == 1012 && a0.kind == User_Address_Type.TYPE_HOME)
    let p = dec.primary ?! panic(\"primary\")
    assert(p.city == \"Amsterdam\")
    assert((dec.stats.get(\"logins\") !? -1) == 42)
    assert((dec.stats.get(\"alerts\") !? -1) == 0)
    let d100 = dec.directory.get(100) ! panic(\"dir100\")
    assert(d100.city == \"Utrecht\" && d100.kind == User_Address_Type.TYPE_OFFICE)
    assert(!isset(dec.password_hash))
    assert((dec.api_key ?? \"\") == \"secret-bytes\")
    assert(dec.default_ == \"escaped-keyword\")

    // 4. Oneof wire overwrite clears sibling
    let ow = protobuf.Writer.new()
    ow.write_string(16, \"hash1\")
    ow.write_bytes(17, \"key2\")
    let od = User.decode_proto(ow.into_bytes()) ! panic(E.message)
    assert(!isset(od.password_hash))
    assert((od.api_key ?? \"\") == \"key2\")

    // 5. Empty message round-trip
    let em = Empty {}
    assert(em.to_proto_bytes().bytes == 0)
    let _ = Empty.decode_proto(\"\") ! panic(E.message)

    // 6. Generated message satisfies ProtoMessage interface
    let wrap = protobuf.Writer.new()
    wrap.write_message(1, home)
    assert(wrap.length > 0)
}
"
    fs.write("%{tmp_dir}/main.valk", driver) ! { assert(false) return }

    // Lint generated code strictly with --deny-warnings!
    let lint_code, lint_out = core.exec("valk build %{tmp_dir} --lint --deny-warnings")
    if lint_code != 0 {
        println("Generated code failed lint:\n%{lint_out}")
        assert(false)
        return
    }

    // Compile and run the generated code end-to-end!
    let run_code, run_out = core.exec("valk build %{tmp_dir} --run")
    if run_code != 0 {
        println("Generated code failed run:\n%{run_out}")
        assert(false)
        return
    }

    fs.delete_all(tmp_dir) _
}

test "CodegenOptions customizes visibility, header, and import module name" {
    let schema = "
syntax = \"proto3\";
message Ping {
    string msg = 1;
}
"
    let file = protobuf.parse_proto(schema) ! { assert(false) return }
    let opts = protobuf.CodegenOptions {
        protobuf_import: "pb"
        public_types: false
        emit_header: false
    }
    let code = protobuf.generate_valk(file, opts)
    assert(!code.contains("DO NOT EDIT"))
    assert(code.contains("use pb"))
    assert(code.contains("class Ping is pb.ProtoMessage {"))
    assert(!code.contains("+ class Ping"))
}
